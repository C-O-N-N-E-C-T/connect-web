# Supabase (anon key only; never put the service_role key in this repo)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# connect-backend base URL (local: http://localhost:3000)
VITE_API_BASE_URL=http://localhost:3000

# real: gerçek POST /api/v1/auth/session (OSP-60, merged) | mock: çağrıyı atlar (yalnızca offline geliştirme)
VITE_AUTH_SESSION_MODE=real
